# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/mindful

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini API (for RAG response generation & text embeddings)
GOOGLE_API_KEY=your_gemini_api_key_here

# Pinecone Vector Store (Optional - in-memory semantic fallback used if unset)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=mental-health-rag

# AssemblyAI (for voice-to-text transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
